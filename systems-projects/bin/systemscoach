#!/bin/sh
set -eu
SYSTEMS_ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
export SYSTEMSCOACH_ROOT="${SYSTEMSCOACH_ROOT:-$SYSTEMS_ROOT}"
if [ -n "${SYSTEMSCOACH_BIN:-}" ]; then
  exec "$SYSTEMSCOACH_BIN" "$@"
fi
legacy_tools=$(dirname "$SYSTEMS_ROOT")/curriculum-tools/courses/grpc/.tools
if [ "${GOPATH:-}" = "$legacy_tools/gopath" ]; then
  unset GOPATH
fi
if [ "${GOCACHE:-}" = "$legacy_tools/go-cache" ]; then
  unset GOCACHE
fi
if ! command -v go >/dev/null 2>&1; then
  shared_go=/usr/local/go/bin/go
  if [ -x "$shared_go" ]; then
    PATH=$(dirname "$shared_go"):$PATH
    export PATH
  fi
fi
if ! command -v go >/dev/null 2>&1; then
  echo 'systemscoach: Go is required; install Go or set SYSTEMSCOACH_BIN to a built binary.' >&2
  exit 127
fi
cd "$SYSTEMS_ROOT"
exec go run ./cmd/systemscoach "$@"

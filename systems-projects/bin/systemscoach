#!/bin/sh
set -eu
SYSTEMS_ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
export SYSTEMSCOACH_ROOT="${SYSTEMSCOACH_ROOT:-$SYSTEMS_ROOT}"
if [ -n "${SYSTEMSCOACH_BIN:-}" ]; then
  exec "$SYSTEMSCOACH_BIN" "$@"
fi
if ! command -v go >/dev/null 2>&1; then
  echo 'systemscoach: Go is required; install Go or set SYSTEMSCOACH_BIN to a built binary.' >&2
  exit 127
fi
cd "$SYSTEMS_ROOT"
exec go run ./cmd/systemscoach "$@"

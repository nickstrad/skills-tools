{
  "tasks": {
    "tutor": "deno run --allow-read --allow-write src/main.ts",
    "build": "deno run --allow-read --allow-write src/build.ts",
    "new-course": "deno run --allow-read --allow-write src/new_course.ts",
    "check": "deno fmt --check && deno lint && deno check src/*.ts tests/*.ts courses/*/curriculum/*.ts",
    "test": "deno test --allow-read --allow-write"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["courses/*/lessons.json"]
  },
  "lint": {
    "exclude": ["templates/"]
  }
}

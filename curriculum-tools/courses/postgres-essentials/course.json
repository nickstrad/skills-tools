{
  "id": "postgres-essentials",
  "name": "PostgreSQL Essentials",
  "description": "40 focused 20\u201330 minute systems lessons after the completed PostgreSQL storage foundation; first three available",
  "tool": "psql",
  "minVersion": "16",
  "revision": 1,
  "repl": {
    "command": [
      "psql",
      "-X",
      "-q",
      "-v",
      "ON_ERROR_STOP=0",
      "-P",
      "pager=off"
    ],
    "echo": "\\echo {marker}",
    "quit": "\\q",
    "env": {
      "PGHOST": "/tmp",
      "PGPORT": "5440",
      "PGUSER": "postgres",
      "PGDATABASE": "lab"
    }
  }
}

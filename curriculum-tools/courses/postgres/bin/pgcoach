#!/bin/sh
# Launcher: resolve this checkout from the script, matching bin/tutor.
set -eu
SELF=$(readlink -f "$0")
COURSE_DIR=$(dirname "$(dirname "$SELF")")
if DENO=$(printenv DENO_BIN 2>/dev/null) && [ -n "$DENO" ]; then :
elif command -v deno >/dev/null 2>&1; then DENO=deno
elif [ -x "$HOME/.deno/bin/deno" ]; then DENO="$HOME/.deno/bin/deno"
elif [ -x /root/.deno/bin/deno ]; then DENO=/root/.deno/bin/deno
else echo "pgcoach: deno not found (set DENO_BIN)" >&2; exit 127; fi
exec "$DENO" run --allow-read --allow-write "$COURSE_DIR/tools/coach.ts" "$@"
